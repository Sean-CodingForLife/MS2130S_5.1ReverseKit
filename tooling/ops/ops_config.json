{
  "server": {
    "port": 8765,
    "port_span": 5,
    "idle_timeout_minutes": 30
  },
  "workspace": {
    "runtime": "runtime",
    "recordings": "captures/recordings",
    "fixed": "captures/fixed"
  },
  "device": {
    "vid": "345F",
    "pid": "2132",
    "product": "USB3 PLUS",
    "channels": 6,
    "sample_rate": 48000,
    "sample_format": "float32",
    "capture_api": "WASAPI",
    "channel_labels": ["FL", "FR", "LFE", "FC", "BL", "BR"],
    "channel_labels_fixed": ["FL", "FR", "FC", "LFE", "BL", "BR"],
    "channel_colors": ["#46e0c0", "#63b3ed", "#f6c453", "#f0a35e", "#68d391", "#f687b3"],
    "level_display_gain": 10,
    "flash_estimate_sec": 360,
    "flash_blocks": 32,
    "signal_window_sec": 0.25,
    "poll_ms": 800,
    "device_cache_sec": 120,
    "max_record_sec": 3600,
    "min_record_sec": 5,
    "record_default_sec": 60,
    "record_presets_sec": [30, 60, 120, 300],
    "verify_record_sec": 5
  },
  "analysis": {
    "active_rms": 0.0001,
    "silence_rms": 0.00001,
    "min_active_channels": 6,
    "duplicate_tolerance": 0.0001
  },
  "snapshot": {
    "baseline": "firmware/release/ms2130s_backup.bin"
  },
  "regress": {
    "skip_dirs": [".git", "__pycache__", "runs", "runtime", "dist", "recordings", "fixed", "node_modules", ".venv"],
    "critical_paths": [
      "操作台.html",
      "design-tokens.css",
      "components.css",
      "tooling/ops/server.py",
      "tooling/ops/verify_wav.py",
      "tooling/ops/regress.py",
      "tooling/ops/ops_config.json",
      "tooling/capture/rec51.ps1",
      "tooling/flash/ms213x_flash.exe",
      "firmware/release/ms2130s_backup.bin"
    ]
  },
  "docs": [
